# Server only. Never put these values in PUBLIC_API_BASE or the frontend.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
PPE_BACKEND=agents
PPE_DEMO_TOKEN=
PPE_ALLOWED_ORIGINS=http://127.0.0.1:34402,http://localhost:34402
PPE_CHAT_ENABLED=true
PPE_DAILY_REQUESTS=30
PPE_REQUESTS_PER_MINUTE=4
PPE_DAILY_TOKEN_BUDGET=1500000
# Responses-only output cap; Agents uses bounded requests/time, not this cap.
PPE_MAX_OUTPUT_TOKENS=5000
# Agents session budgets require account enablement. Never silently fall back.
PPE_AGENT_BUDGET_ENABLED=false
# Used only when PPE_AGENT_BUDGET_ENABLED=true (up to two sessions per chat).
PPE_AGENT_SESSION_CENTS=50
PPE_AGENT_DAILY_CENTS=500
# Persistent usage ledger; no prompts, answers or credentials are stored.
PPE_USAGE_DB=.runtime/usage.sqlite3
# Create this file to stop new paid requests without restarting.
PPE_STOP_FILE=.runtime/STOP
# Build-time public HTTPS API URL; empty = same-origin API.
PUBLIC_API_BASE=
# Optional: path to the pre-existing kit-catalog directory, never copied to dist/Git.
# Photos are served to direct loopback or the explicitly allowed private tailnet user.
PPE_LOCAL_PHOTOS_DIR=
# Optional private Tailscale Serve preview. Keep PPE_HOST=127.0.0.1; never use Funnel.
# Add this exact HTTPS origin (including port) to PPE_ALLOWED_ORIGINS as well.
# Example: https://your-device.your-tailnet.ts.net:9443
PPE_TAILSCALE_ORIGIN=
# Login of the Tailscale user allowed to view existing private photos.
PPE_TAILSCALE_USER_LOGIN=
