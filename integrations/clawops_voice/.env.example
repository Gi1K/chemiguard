# Copy this file to the repository root as .env.clawops (private; chmod 600).
# Keep disabled until credentials and the intended recipient have been configured.
CLAWOPS_ENABLED=false
CLAWOPS_AUTO_CALL=false
CLAWOPS_API_KEY=
CLAWOPS_ACCOUNT_ID=
CLAWOPS_FROM_NUMBER=
CLAWOPS_TO_NUMBER=
# Must exactly match the policy's zone_id (작업 기준 → 담당 개소).
CLAWOPS_ZONE_ID=시연 구역
# Reuse OPENAI_API_KEY from the process/.env, or reference an existing private file.
CHEMIGUARD_ENV_FILE=
# No AgentId, external TTS, model/provider override or third-party AI fallback.
